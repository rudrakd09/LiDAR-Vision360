# Copy this file to `.env` in the repository root (and/or perception/.env) and adjust values.
# Never commit the real `.env` file — it is excluded via .gitignore.
#
# All variables are prefixed LIDAR_ and are read by perception/src/common/config.py
# (pydantic-settings). Every value here has a built-in default in code; this file exists so
# nothing that varies per-environment (thresholds, ports, credentials) needs to be hard-coded.

# --- General ---
LIDAR_ENVIRONMENT=development
LIDAR_LOG_LEVEL=INFO

# --- LiDAR range/rate (Phase 2 onward; reused by Phase 3 range validation) ---
LIDAR_LIDAR_RANGE_MIN_M=0.05
LIDAR_LIDAR_RANGE_MAX_M=12.0
LIDAR_LIDAR_NUM_POINTS=360
LIDAR_LIDAR_SCAN_FREQUENCY_HZ=10.0

# --- LiDAR angular sampling and simulated noise (Phase 2, simulator/) ---
LIDAR_LIDAR_ANGULAR_RESOLUTION_DEG=1.0
LIDAR_LIDAR_DISTANCE_NOISE_STD_M=0.02
LIDAR_LIDAR_OUTLIER_PROBABILITY=0.0
LIDAR_LIDAR_MISSING_PROBABILITY=0.0
# LIDAR_LIDAR_RANDOM_SEED=42   # unset (default) = non-deterministic; an empty value is invalid
#                              # for this int|None field -- uncomment with a value, or leave
#                              # commented out entirely to keep the "no fixed seed" default.

# --- Vehicle / safety parameters (Phase 9-10 onward) ---
LIDAR_VEHICLE_WIDTH_M=1.8
LIDAR_VEHICLE_LENGTH_M=4.5

# --- Vehicle-mounted LiDAR pose (Phase 2). Defaults to vehicle center, no rotation. ---
LIDAR_LIDAR_MOUNT_X_M=0.0
LIDAR_LIDAR_MOUNT_Y_M=0.0
LIDAR_LIDAR_MOUNT_ORIENTATION_DEG=0.0

# --- Preprocessing (Phase 3, perception/src/preprocessing/) ---
LIDAR_PREPROCESSING_OUTLIER_THRESHOLD_M=0.5
LIDAR_PREPROCESSING_OUTLIER_WINDOW_SIZE=5
LIDAR_PREPROCESSING_MEDIAN_FILTER_WINDOW=5
LIDAR_PREPROCESSING_TEMPORAL_FILTER_ENABLED=false
LIDAR_PREPROCESSING_TEMPORAL_FILTER_ALPHA=0.5

# --- Cloud backend (Phase 12 onward) ---
LIDAR_BACKEND_HOST=0.0.0.0
LIDAR_BACKEND_PORT=8000

# --- Database (Phase 13 onward) ---
LIDAR_DATABASE_URL=postgresql://lidar:lidar@localhost:5432/lidar_vision360

# --- Sensor source selection (sensor input abstraction -- see docs/architecture.md "Sensor
# source abstraction", perception/src/datasources/). "simulation" -> scripts/sensor_source.py
# builds a simulator.SimulatorSource for the --scenario given to scripts/serve_unity_bridge.py.
# "hardware" -> datasources.STM32Source -- connection/framing/CRC/sequence/reconnect/health
# architecture is implemented (Phase 8), but connect() raises STM32ConfigurationError until every
# field below is set to a real value from the hardware team's spec -- see
# docs/hardware-integration.md "Hardware integration checklist".
# "esp32_serial" -> datasources.esp32_serial.ESP32SerialSource -- THE REAL, IN-SERVICE HARDWARE
# PATH: LiDAR -> STM32 -> ESP32 -> USB serial -> this PC, carrying RAW "A:<deg> , D:<mm>"
# measurements that the Edge's own full perception pipeline then processes. See the block below
# and docs/esp32-serial-integration.md.
# Any value other than these three is rejected loudly, never silently defaulted -- in particular
# no live mode can ever fall back to simulated data.
LIDAR_DATA_SOURCE=simulation
# LIDAR_DATA_SOURCE=esp32_serial
# LIDAR_DATA_SOURCE=hardware

# --- ESP32 USB-SERIAL RAW-MEASUREMENT LINK (LIDAR_DATA_SOURCE=esp32_serial) ------------------
# Unlike the LIDAR_STM32_* protocol block below -- deliberately unset because that binary format
# is unknown -- this wire format IS known and fixed, so these have real working defaults:
#     A:45 , D:1200      one measurement per line; angle in degrees, distance in millimetres
#     (whitespace around ':' and ',' is not significant)
#
# THE ONLY VALUE YOU MUST SET FOR YOUR MACHINE IS THE COM PORT.
# Find it with:  python scripts/sniff_esp32.py --list
LIDAR_ESP32_SERIAL_PORT=COM5
LIDAR_ESP32_SERIAL_BAUDRATE=115200
# LIDAR_ESP32_SERIAL_SOURCE_ID=esp32_serial   # session/source label on every frame

# Link timing. READ_TIMEOUT is the reader thread's blocking-read granularity, not a data rate.
# SCAN_TIMEOUT is how long read_scan() waits for a COMPLETE revolution before reporting
# HARDWARE_DATA_UNAVAILABLE to the dashboard (it never fabricates points to fill the gap).
LIDAR_ESP32_SERIAL_READ_TIMEOUT_S=0.1
LIDAR_ESP32_SERIAL_SCAN_TIMEOUT_S=5.0
LIDAR_ESP32_SERIAL_RECONNECT_INITIAL_BACKOFF_S=1.0
LIDAR_ESP32_SERIAL_RECONNECT_MAX_BACKOFF_S=10.0
# LIDAR_ESP32_SERIAL_MAX_RECONNECT_ATTEMPTS=  # unset = retry indefinitely (recommended)
# Bounded reader->pipeline queue. When full the OLDEST lines are dropped so the pipeline always
# works on the freshest data; drops are counted and warned about, never silent.
LIDAR_ESP32_SERIAL_MAX_BUFFERED_LINES=20000

# Scan-boundary detection. A revolution ends when the angle jumps BACKWARDS by more than
# WRAP_THRESHOLD_DEG (359 -> 0). 180 deg is far above sampling jitter and far below a full sweep,
# so a scan is detected even when it skips angle 0 entirely.
LIDAR_ESP32_SERIAL_WRAP_THRESHOLD_DEG=180.0
# Boundaries yielding fewer points than this are discarded, not published -- a handful of noise
# points is not a scan. Lower it if your firmware emits very few points per revolution.
LIDAR_ESP32_SERIAL_MIN_POINTS_PER_SCAN=10
LIDAR_ESP32_SERIAL_MAX_POINTS_PER_SCAN=5000
# A pending scan open longer than this is force-completed (stalled motor / stuck angle).
LIDAR_ESP32_SERIAL_MAX_SCAN_DURATION_S=2.0
# Bearing measured twice in one revolution: "last" (newest wins) | "first" | "keep_all".
LIDAR_ESP32_SERIAL_DUPLICATE_ANGLE_POLICY=last
# Periodic health summary every N scans (0 disables). Per-scan logging at 10 Hz floods a terminal.
LIDAR_ESP32_SERIAL_LOG_EVERY_N_SCANS=20

# The LIVE ENVIRONMENT MAP's point cloud needs raw points on the wire. "polar" is the compact
# default (the dashboard converts); "cartesian"/"both" send x/y instead. "none" disables it.
# LIDAR_STREAMING_POINT_MODE=polar

# --- STM32 wire-protocol config (Phase 8 architecture scaffolding; real values are Phase 16).
# Every LIDAR_STM32_* variable below except port/baudrate/timing is commented out because it has
# no safe default -- STM32Source.connect() deliberately fails loudly (STM32ConfigurationError)
# rather than guess any of these. See docs/hardware-integration.md for what each one means and
# where it comes from. ---
LIDAR_STM32_UART_PORT=COM3
LIDAR_STM32_UART_BAUDRATE=115200
LIDAR_STM32_CONNECT_TIMEOUT_S=5.0
LIDAR_STM32_READ_TIMEOUT_S=2.0
LIDAR_STM32_RECONNECT_INITIAL_BACKOFF_S=1.0
LIDAR_STM32_RECONNECT_MAX_BACKOFF_S=10.0
# LIDAR_STM32_MAX_RECONNECT_ATTEMPTS=       # unset = retry indefinitely

# LIDAR_STM32_FRAME_START_MARKER=            # hex string, e.g. AA55 -- delimited framing
# LIDAR_STM32_FRAME_END_MARKER=              # hex string, optional
# LIDAR_STM32_FRAME_LENGTH_BYTES=            # OR fixed-length framing instead of markers
# LIDAR_STM32_BYTE_ORDER=                    # little | big

# LIDAR_STM32_MESSAGE_TYPE_OFFSET=
# LIDAR_STM32_MESSAGE_TYPE_WIDTH=1
# LIDAR_STM32_SEQUENCE_NUMBER_OFFSET=
# LIDAR_STM32_SEQUENCE_NUMBER_WIDTH=2
# LIDAR_STM32_SEQUENCE_MODULUS=              # e.g. 65536 for a wrapping uint16 counter

# LIDAR_STM32_LIDAR_MESSAGE_TYPE=
# LIDAR_STM32_RADAR_MESSAGE_TYPE=

# LIDAR_STM32_CRC_ALGORITHM=                 # none | xor8 | sum8 | crc8 | crc16_ccitt

# LIDAR_STM32_LIDAR_DISTANCE_SCALE=
# LIDAR_STM32_LIDAR_ANGLE_SCALE=
# LIDAR_STM32_RADAR_RANGE_SCALE=
# LIDAR_STM32_RADAR_VELOCITY_SCALE=

# LIDAR_STM32_TIMESTAMP_FORMAT=              # unix_epoch_ms | unix_epoch_s | device_uptime_ms | none

# --- ESP32 gateway (Phase 3, datasources.esp32) -- STM32 -> ESP32 -> Wi-Fi -> Edge, carrying
# ALREADY-PROCESSED perception frames. Selected by LIDAR_DATA_SOURCE=hardware. Every value whose
# meaning depends on the hardware team's spec is left unset; ESP32Source.connect() fails loudly
# (ESP32ConfigurationError) rather than guess. See docs/esp32-integration.md. ---
# LIDAR_ESP32_TRANSPORT=                     # unset = not configured (connect() fails). "mock" =
#                                           # SIMULATED ESP32 transport (scripted frames, dev only).
#                                           # Real values (tcp/udp/mqtt/websocket/...) are NOT
#                                           # implemented -- the Wi-Fi protocol is unspecified.
# LIDAR_ESP32_HOST=                          # no default IP invented
# LIDAR_ESP32_PORT=                          # no default port invented
# LIDAR_ESP32_AUTH_TOKEN=                    # if the future transport needs one
# LIDAR_ESP32_PROTOCOL=                      # framing/encoding hint for a future non-JSON codec
LIDAR_ESP32_CONNECT_TIMEOUT_S=5.0
LIDAR_ESP32_READ_TIMEOUT_S=2.0
LIDAR_ESP32_RECONNECT_INITIAL_BACKOFF_S=1.0
LIDAR_ESP32_RECONNECT_MAX_BACKOFF_S=10.0
# LIDAR_ESP32_MAX_RECONNECT_ATTEMPTS=       # unset = retry indefinitely
LIDAR_ESP32_FRAME_STALE_AFTER_S=1.0
LIDAR_ESP32_HEARTBEAT_TIMEOUT_S=6.0
# LIDAR_ESP32_SEQUENCE_MODULUS=             # e.g. 65536 for a wrapping uint16 counter
LIDAR_ESP32_MOCK_FRAME_COUNT=200            # only used when LIDAR_ESP32_TRANSPORT=mock
# LIDAR_ESP32_MOCK_SCENARIO=                 # only when LIDAR_ESP32_TRANSPORT=mock. unset /
#                                           # "approaching_vehicle" = legacy scripted sequence;
#                                           # "realtime_arc" | "multi_object" | "tracking" =
#                                           # Phase-10 MOCK STM32 HARDWARE OUTPUT scenes.

# --- STM32 -> Vehicle-ECU CAN output (Phase 5, can_output/) -- a SOFTWARE MODEL of the CAN
# transmit stage the STM32 firmware performs in the real vehicle. Independent of the ESP32 path.
# Off by default. NO CAN parameter is invented -- bitrate/IDs/DLC/layout/scaling/checksum/periods
# are all PENDING the hardware team's CAN/DBC spec. See docs/can-output.md. ---
LIDAR_CAN_OUTPUT_ENABLED=false
LIDAR_CAN_OUTPUT_BACKEND=mock               # mock = SIMULATED CAN OUTPUT | logging = [SIM-CAN] log sink
# --- PENDING hardware / DBC spec -- fill in from the ECU spec, never guess ---
# LIDAR_CAN_OUTPUT_BITRATE_BPS=             # e.g. 250000 / 500000
# LIDAR_CAN_OUTPUT_INTERFACE=               # e.g. can0 / PCAN_USBBUS1
# LIDAR_CAN_OUTPUT_DEFAULT_CYCLE_TIME_MS=   # fallback tx period for a message with no cycle_time_ms
# LIDAR_CAN_OUTPUT_CHECKSUM_ALGORITHM=      # none | xor8 | sum8 | crc8 | crc16_ccitt (WHICH is PENDING)
# LIDAR_CAN_OUTPUT_SEQUENCE_MODULUS=        # rolling-counter wrap, e.g. 16 for a 4-bit counter
# --- Edge-side operational guards (NOT hardware facts) ---
LIDAR_CAN_OUTPUT_MAX_TRANSMIT_RATE_HZ=100.0
LIDAR_CAN_OUTPUT_QUEUE_MAX_FRAMES=64
LIDAR_CAN_OUTPUT_REQUIRE_FULLY_SPECIFIED=false   # true -> refuse to start until every PENDING field is filled
LIDAR_CAN_OUTPUT_BUS_RECOVERY_INITIAL_BACKOFF_S=1.0
LIDAR_CAN_OUTPUT_BUS_RECOVERY_MAX_BACKOFF_S=10.0
