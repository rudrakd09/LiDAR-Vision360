# Copy this file to `.env` in the repository root (and/or perception/.env) and adjust values.
# Never commit the real `.env` file — it is excluded via .gitignore.
#
# All variables are prefixed LIDAR_ and are read by perception/src/common/config.py
# (pydantic-settings). Every value here has a built-in default in code; this file exists so
# nothing that varies per-environment (thresholds, ports, credentials) needs to be hard-coded.

# --- General ---
LIDAR_ENVIRONMENT=development
LIDAR_LOG_LEVEL=INFO

# --- LiDAR range/rate (Phase 2 onward; reused by Phase 3 range validation) ---
LIDAR_LIDAR_RANGE_MIN_M=0.05
LIDAR_LIDAR_RANGE_MAX_M=12.0
LIDAR_LIDAR_NUM_POINTS=360
LIDAR_LIDAR_SCAN_FREQUENCY_HZ=10.0

# --- LiDAR angular sampling and simulated noise (Phase 2, simulator/) ---
LIDAR_LIDAR_ANGULAR_RESOLUTION_DEG=1.0
LIDAR_LIDAR_DISTANCE_NOISE_STD_M=0.02
LIDAR_LIDAR_OUTLIER_PROBABILITY=0.0
LIDAR_LIDAR_MISSING_PROBABILITY=0.0
# LIDAR_LIDAR_RANDOM_SEED=42   # unset (default) = non-deterministic; an empty value is invalid
#                              # for this int|None field -- uncomment with a value, or leave
#                              # commented out entirely to keep the "no fixed seed" default.

# --- Vehicle / safety parameters (Phase 9-10 onward) ---
LIDAR_VEHICLE_WIDTH_M=1.8
LIDAR_VEHICLE_LENGTH_M=4.5

# --- Vehicle-mounted LiDAR pose (Phase 2). Defaults to vehicle center, no rotation. ---
LIDAR_LIDAR_MOUNT_X_M=0.0
LIDAR_LIDAR_MOUNT_Y_M=0.0
LIDAR_LIDAR_MOUNT_ORIENTATION_DEG=0.0

# --- Preprocessing (Phase 3, perception/src/preprocessing/) ---
LIDAR_PREPROCESSING_OUTLIER_THRESHOLD_M=0.5
LIDAR_PREPROCESSING_OUTLIER_WINDOW_SIZE=5
LIDAR_PREPROCESSING_MEDIAN_FILTER_WINDOW=5
LIDAR_PREPROCESSING_TEMPORAL_FILTER_ENABLED=false
LIDAR_PREPROCESSING_TEMPORAL_FILTER_ALPHA=0.5

# --- Cloud backend (Phase 12 onward) ---
LIDAR_BACKEND_HOST=0.0.0.0
LIDAR_BACKEND_PORT=8000

# --- Database (Phase 13 onward) ---
LIDAR_DATABASE_URL=postgresql://lidar:lidar@localhost:5432/lidar_vision360

# --- Sensor source selection (sensor input abstraction -- see docs/architecture.md "Sensor
# source abstraction", perception/src/datasources/). "simulation" -> scripts/sensor_source.py
# builds a simulator.SimulatorSource for the --scenario given to scripts/serve_unity_bridge.py.
# "hardware" -> datasources.STM32Source -- connection/framing/CRC/sequence/reconnect/health
# architecture is implemented (Phase 8), but connect() raises STM32ConfigurationError until every
# field below is set to a real value from the hardware team's spec -- see
# docs/hardware-integration.md "Hardware integration checklist". Any other value than
# "simulation"/"hardware" is rejected loudly, never silently defaulted. ---
LIDAR_DATA_SOURCE=simulation
# LIDAR_DATA_SOURCE=hardware

# --- STM32 wire-protocol config (Phase 8 architecture scaffolding; real values are Phase 16).
# Every LIDAR_STM32_* variable below except port/baudrate/timing is commented out because it has
# no safe default -- STM32Source.connect() deliberately fails loudly (STM32ConfigurationError)
# rather than guess any of these. See docs/hardware-integration.md for what each one means and
# where it comes from. ---
LIDAR_STM32_UART_PORT=COM3
LIDAR_STM32_UART_BAUDRATE=115200
LIDAR_STM32_CONNECT_TIMEOUT_S=5.0
LIDAR_STM32_READ_TIMEOUT_S=2.0
LIDAR_STM32_RECONNECT_INITIAL_BACKOFF_S=1.0
LIDAR_STM32_RECONNECT_MAX_BACKOFF_S=10.0
# LIDAR_STM32_MAX_RECONNECT_ATTEMPTS=       # unset = retry indefinitely

# LIDAR_STM32_FRAME_START_MARKER=            # hex string, e.g. AA55 -- delimited framing
# LIDAR_STM32_FRAME_END_MARKER=              # hex string, optional
# LIDAR_STM32_FRAME_LENGTH_BYTES=            # OR fixed-length framing instead of markers
# LIDAR_STM32_BYTE_ORDER=                    # little | big

# LIDAR_STM32_MESSAGE_TYPE_OFFSET=
# LIDAR_STM32_MESSAGE_TYPE_WIDTH=1
# LIDAR_STM32_SEQUENCE_NUMBER_OFFSET=
# LIDAR_STM32_SEQUENCE_NUMBER_WIDTH=2
# LIDAR_STM32_SEQUENCE_MODULUS=              # e.g. 65536 for a wrapping uint16 counter

# LIDAR_STM32_LIDAR_MESSAGE_TYPE=
# LIDAR_STM32_RADAR_MESSAGE_TYPE=

# LIDAR_STM32_CRC_ALGORITHM=                 # none | xor8 | sum8 | crc8 | crc16_ccitt

# LIDAR_STM32_LIDAR_DISTANCE_SCALE=
# LIDAR_STM32_LIDAR_ANGLE_SCALE=
# LIDAR_STM32_RADAR_RANGE_SCALE=
# LIDAR_STM32_RADAR_VELOCITY_SCALE=

# LIDAR_STM32_TIMESTAMP_FORMAT=              # unix_epoch_ms | unix_epoch_s | device_uptime_ms | none
